# Copy to .env.local and fill in values

# backend-rs-sql base URL — the mobile-config source, the pool listing proxy,
# AND the upload proxy (the backend owns the Filebase credentials; this
# service holds none). In the colocated production deployment this is
# http://127.0.0.1:3000 — the backend trusts X-Forwarded-For only from
# loopback, so the service forwards each caller's IP and geo/upload limits
# apply per agent. Transport rule (enforced at startup): a REMOTE backend
# must be https; http is accepted only for loopback (127.0.0.0/8, localhost,
# ::1).
BACKEND_URL=http://127.0.0.1:3000

# Optional partner keys — comma-separated <id>:<secret> pairs (callers send
# X-Api-Key: <id>:<secret>). A valid key skips the per-network rate limit;
# an unknown key -> 401; no key -> served under the per-network limit.
# Distribute out of band; revoke by removing the entry and redeploying.
# AGENT_API_KEYS=agent-one:replace-with-32-random-hex,agent-two:another-secret

# Partner upload lane — same value as the backend's UPLOAD_PARTNER_TOKEN
# (>= 32 chars). Partner-key launches then use the partner's own backend
# upload bucket instead of the shared egress IP's 10/hour.
# UPLOAD_PARTNER_TOKEN=replace-with-32-random-hex

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Donation claim authorities — the pool-config `feeClaimer` values that make a
# launch config cause-capable (drives `supportsCause` on GET /api/configs and
# the donation rules on POST /api/launch).
# Mirrors redesign/launchpad-mobile-redesign/config/production-manifest.json
# targets.production.donationClaimAuthorities.
# Comma-separated base58 pubkeys. Value comes from the app's production
# manifest: launchpad-mobile-redesign/config/production-manifest.json →
# targets.production.donationClaimAuthorities (the approved
# EXPO_PUBLIC_DONATION_CLAIM_AUTHORITY set): the operator claimer of 61UBwyZf…
# plus the claim PDAs of the four tf-bootstrap configs (dbc-config record
# a9e9864). Update it with the app's value whenever new configs ship. Unset/empty is valid and means no config is cause-capable.
DONATION_CLAIM_AUTHORITIES=FdrDZPcYEjdB3nQGUgL7muXj4SBTzbAMMvMosufdtun1,6do3n9N3LcxP25Xuf7GVQHhN4zq34Q7JBwQn8bEJEvLA,Dns4QCBLbN5i5wGQVZzSHXyq2wowPtAR9bMQ9sZre3sY,6FbwfdYPRrjaWtNgAxSnDZBsDpXine9MadQn4mPjvUF9,Drd7MtoMPfTk8MqNtAb2DmsaVrPPcnM9L2YHSmM9uuw8
