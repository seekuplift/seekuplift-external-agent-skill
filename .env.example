# Copy to .env.local and fill in values

# Filebase IPFS credentials (same as mobile app's EXPO_PUBLIC_FILEBASE_API_KEY)
FILEBASE_API_KEY=

# IPFS gateway URL (default: https://ipfs.filebase.io/ipfs)
IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs

# backend-rs-sql base URL for the mobile-config source and pool listing proxy.
# In the colocated production deployment this is http://localhost:3000 — the
# backend trusts X-Forwarded-For only from loopback, so the service forwards
# each caller's IP and geo/upload limits apply per agent.
BACKEND_URL=http://localhost:3000

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Donation claim authorities — the pool-config `feeClaimer` values that make a
# launch config cause-capable (drives `supportsCause` on GET /api/configs).
# Comma-separated base58 pubkeys. Value comes from the app's production
# manifest: launchpad-mobile-redesign/config/production-manifest.json →
# targets.production.donationClaimAuthorities (the approved
# EXPO_PUBLIC_DONATION_CLAIM_AUTHORITY set — today the temporary operator
# claimer of the live config). Update it with the app's value whenever new
# configs ship. Unset/empty is valid and means no config is cause-capable.
DONATION_CLAIM_AUTHORITIES=FdrDZPcYEjdB3nQGUgL7muXj4SBTzbAMMvMosufdtun1
