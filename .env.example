# Copy to .env.local and fill in values

# Filebase IPFS credentials (same as mobile app's EXPO_PUBLIC_FILEBASE_API_KEY)
FILEBASE_API_KEY=

# IPFS gateway URL (default: https://ipfs.filebase.io/ipfs)
IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs

# backend-rs-sql base URL for pool listing proxy
BACKEND_URL=http://localhost:3000

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
