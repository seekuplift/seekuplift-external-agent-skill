# /opt/skill/.env — production (hosts A+B). 0600, owner skill.
# No secrets in git: render this locally, ship it with deploy/install-skill.sh,
# then shred the rendered copy.

# backend-rs-sql over loopback. The backend trusts X-Forwarded-For only from
# 127.0.0.1 (TRUSTED_PROXY_IPS), so the service forwards each caller's IP — geo
# verdicts and the 10/hour upload budget apply per calling agent, not per host.
BACKEND_URL=http://127.0.0.1:3000

# Optional partner keys — comma-separated <id>:<secret> pairs (callers send
# X-Api-Key: <id>:<secret>) that skip the per-network rate limit. Issued by
# the operator, distributed out of band, revoked by redeploy. Empty = no
# partners; keyless calls are always served under the per-network limit.
AGENT_API_KEYS=<id>:<openssl-rand-hex-32>,<id2>:<secret2>

# Private mainnet RPC (Helius/QuickNode/Triton). The public endpoint
# rate-limits aggressively; /api/launch and /api/trade/* make several RPC calls
# per request.
SOLANA_RPC_URL=<private-mainnet-rpc-url>

# Donation claim authorities — comma-separated base58 pubkeys; the pool-config
# feeClaimer values that make a launch config cause-capable. MUST track the
# app's config/production-manifest.json → targets.production.donationClaimAuthorities
# (EXPO_PUBLIC_DONATION_CLAIM_AUTHORITY) — update it whenever the app ships new
# configs or the value changes. Unset/empty is valid: no config is
# cause-capable.
DONATION_CLAIM_AUTHORITIES=<comma-separated-base58-pubkeys>
